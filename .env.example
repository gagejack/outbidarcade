# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real keys.

# Stripe dashboard -> Developers -> API keys -> Secret key (test mode
# while building: sk_test_..., switch to sk_live_... only when going live)
STRIPE_SECRET_KEY=sk_test_...

# From `stripe listen` while developing locally, or from the webhook
# endpoint's signing secret in the Stripe dashboard once deployed
STRIPE_WEBHOOK_SECRET=whsec_...
